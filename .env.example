# .env.example = MODÈLE du fichier .env (sans secrets dedans)
# (Le vrai fichier .env contiendra tes vraies clés — il est dans .gitignore donc jamais partagé)
#
# Procédure :
# 1. Copie ce fichier en ".env"           : copy .env.example .env
# 2. Remplis les vraies clés API ci-dessous
# 3. ⚠️ NE COMMIT JAMAIS le .env (= ne le push pas sur GitHub)

# ─── Clé API LLM (briefs exécutifs) ───
ANTHROPIC_API_KEY=sk-ant-...

# ─── Session — signature des cookies (OBLIGATOIRE en prod) ───
# Génère une chaîne aléatoire : python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-with-a-strong-random-string

# ─── Email admin (devient automatiquement is_admin à l'inscription) ───
ADMIN_EMAIL=admin@votre-domaine.com

# ─── Stripe Checkout (paiement par carte bancaire) ───
# Si vide : mode "demande de contact" (l'utilisateur ne paie pas, activation manuelle)
# 1. Crée un compte sur https://stripe.com
# 2. Récupère tes clés API : Developers → API keys
# 3. Crée 3 produits récurrents (Essentiel 29€, Pro 79€, Agency 249€) dans le dashboard
# 4. Copie l'ID de chaque "price" (commence par price_...) dans les variables ci-dessous
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
# Pour les webhooks : Developers → Webhooks → Add endpoint → /webhook/stripe → copier le signing secret
STRIPE_WEBHOOK_SECRET=

# ─── SMTP (envoi d'emails transactionnels : bienvenue, reset password) ───
# Si vide : les emails sont sauvegardés en local dans logs/emails/ (mode dev)
# Recommandé en prod : Resend, Postmark, Mailgun, SendGrid, ou Gmail (avec mot de passe d'application)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@argus-security.com
SMTP_FROM_NAME=ARGUS Security
SMTP_USE_TLS=1

# ─── Mode production ───
# DEBUG=0 fait crasher le serveur si SESSION_SECRET n'est pas défini
DEBUG=1
# SESSION_HTTPS_ONLY=1 pour interdire la session sur HTTP (à activer en prod derrière HTTPS)
SESSION_HTTPS_ONLY=0
